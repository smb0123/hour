# ── 데이터베이스 ─────────────────────────────────────────────
# 로컬 개발: 비워두면 local.db 파일을 자동 생성해서 사용합니다.
# Vercel 배포: Turso에서 발급받은 값을 넣으세요.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ── 로그인 ───────────────────────────────────────────────────
# 세션 서명용 비밀 키 (16자 이상, 길고 랜덤하게). 생성: openssl rand -base64 32
AUTH_SECRET=
# 회원가입할 때 입력해야 하는 코드. 팀원에게만 알려주세요. 비우면 가입이 닫힙니다.
SIGNUP_CODE=
